@page "/gacha-pool"
@using global::Monica.Core.Results
@inject GachaPoolDashboardState State
@inject IStringLocalizer<GachaPoolResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["Page:DocumentTitle"]</PageTitle>

<div class="gacha-page">
  <div class="gacha-page__hero-wrap">
    <MudPaper Class="gacha-page__hero" Elevation="2">
      <div class="gacha-page__hero-copy">
        <MudText Typo="Typo.overline" Color="Color.Primary">@L["Page:Eyebrow"]</MudText>
        <MudText Typo="Typo.h3">@L["Page:Title"]</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Page:Subtitle"]</MudText>
      </div>
      <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Large" />
      </MudAvatar>
    </MudPaper>
  </div>

  @if (!_initialized)
  {
    <div class="gacha-page__loading">
      <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
      <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Page:Loading"]</MudText>
    </div>
  }
  else if (State.Pools.Count == 0)
  {
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
      <MudText Typo="Typo.h6">@L["Empty:Title"]</MudText>
      <MudText Typo="Typo.body2">@L["Empty:Subtitle"]</MudText>
    </MudAlert>
  }
  else if (State.SelectedPool is { } pool)
  {
    <div class="gacha-page__toolbar-wrap">
      <MudPaper Class="gacha-page__toolbar" Elevation="1">
        <MudSelect T="string"
                   Label="@L["PoolSelector:Label"]"
                   Value="@State.SelectedPoolId"
                   ValueChanged="@SelectPool"
                   Variant="Variant.Outlined">
          @foreach (var availablePool in State.Pools)
          {
            <MudSelectItem T="string" Value="@availablePool.Id">@availablePool.DisplayName</MudSelectItem>
          }
        </MudSelect>

        <MudNumericField T="int"
                         Label="@L["Actions:BatchSize"]"
                         @bind-Value="@State.BatchSize"
                         Min="1"
                         Max="@State.MaximumBatchSize"
                         Variant="Variant.Outlined" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Casino"
                   OnClick="@DrawOne">
          @L["Actions:DrawOnce"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.BurstMode"
                   OnClick="@DrawBatch">
          @L["Actions:DrawBatch"]
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.RestartAlt"
                   OnClick="@ResetPool">
          @L["Actions:Reset"]
        </MudButton>
      </MudPaper>
    </div>

    <MudGrid Spacing="3">
      <MudItem xs="12" md="7">
        <div class="gacha-page__pool-summary-wrap">
          <MudPaper Class="gacha-page__pool-summary" Elevation="1">
            <MudText Typo="Typo.overline" Color="Color.Primary">@pool.Id</MudText>
            <MudText Typo="Typo.h5">@pool.DisplayName</MudText>
            @if (!string.IsNullOrWhiteSpace(pool.Description))
            {
              <MudText Typo="Typo.body2" Color="Color.Secondary">@pool.Description</MudText>
            }

            <div class="gacha-page__metrics">
              <div>
                <MudText Typo="Typo.h5">@pool.TotalDraws</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Metrics:TotalDraws"]</MudText>
              </div>
              <div>
                <MudText Typo="Typo.h5">@pool.AvailablePrizeCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Metrics:AvailablePrizes"]</MudText>
              </div>
              <div>
                <MudText Typo="Typo.h5">@pool.NoPrizeProbability.ToString("P2")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Metrics:NoPrizeProbability"]</MudText>
              </div>
            </div>
          </MudPaper>
        </div>
      </MudItem>
      <MudItem xs="12" md="5">
        <GachaDrawSpotlight Result="@State.LatestDraws.FirstOrDefault()" />
      </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
      <MudItem xs="12" lg="8">
        <GachaPrizeTable Pool="@pool" />
      </MudItem>
      <MudItem xs="12" lg="4">
        <GachaRecentDraws Draws="@pool.RecentDraws" />
      </MudItem>
    </MudGrid>
  }
</div>

@code {
  public const string PAGE_URL = "/gacha-pool";

  private bool _initialized;

  protected override Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return Task.CompletedTask;
    }

    ShowError(State.Initialize());
    _initialized = true;
    StateHasChanged();
    return Task.CompletedTask;
  }

  private void SelectPool(string? poolId)
  {
    if (!string.IsNullOrWhiteSpace(poolId))
    {
      ShowError(State.SelectPool(poolId));
    }
  }

  private void DrawOne()
  {
    var response = State.DrawOne();
    if (!ShowError(response))
    {
      Snackbar.Add(L["Messages:DrawCompleted"], Severity.Success);
    }
  }

  private void DrawBatch()
  {
    var response = State.DrawBatch();
    if (!ShowError(response))
    {
      Snackbar.Add(L["Messages:BatchCompleted", State.BatchSize], Severity.Success);
    }
  }

  private void ResetPool()
  {
    var response = State.Reset();
    if (!ShowError(response))
    {
      Snackbar.Add(L["Messages:ResetCompleted"], Severity.Success);
    }
  }

  private bool ShowError(Res response)
  {
    if (!response.IsFailed(out var error))
    {
      return false;
    }

    Snackbar.Add(error.Message ?? L["Messages:UnknownError"], Severity.Error);
    return true;
  }
}
